# printershare — environment variables
# Copy to .env and edit before running `make wizard` or `make start`

# ── Host paths ──────────────────────────────────────────────────
# Where scans land on the Linux host (shared via Samba, NFS, portal)
SCANS_HOST_PATH=/srv/printershare/scans

# ── CUPS ────────────────────────────────────────────────────────
CUPS_ADMIN_USER=admin
CUPS_ADMIN_PASS=changeme
CUPS_PORT=631

# ── ipp-usb / AirPrint ──────────────────────────────────────────
# ipp-usb exposes USB printer as IPP at this port (auto-detected)
IPP_USB_PORT=60000

# ── Scanservjs ──────────────────────────────────────────────────
RCLONE_GDRIVE_REMOTE=gdrive
RCLONE_ONEDRIVE_REMOTE=onedrive

# ── Samba ───────────────────────────────────────────────────────
# Windows: \\<SERVER_IP>\Scans   macOS: smb://<SERVER_IP>/Scans
SAMBA_USER=scanner
SAMBA_PASS=changeme

# ── Nginx ───────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── NFS ─────────────────────────────────────────────────────────
NFS_ALLOWED_SUBNET=192.168.0.0/16

# ── Portal ──────────────────────────────────────────────────────
# Set PORTAL_AUTH=true to require a password for the portal web UI
PORTAL_AUTH=false
PORTAL_USER=admin
# If PORTAL_PASS is empty, PORTAL_SECRET is used as the API auth password
PORTAL_PASS=
PORTAL_SECRET=changeme-portal-secret

# ── Paperless-ngx (enable with: COMPOSE_PROFILES=docs) ─────────
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASS=changeme
PAPERLESS_DB_PASS=changeme-paperless
PAPERLESS_SECRET_KEY=changeme-paperless-secret
TZ=UTC
OCR_LANGUAGE=eng

# ── Remote access (enable with: COMPOSE_PROFILES=remote) ───────
# Tailscale VPN: get auth key at https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTH_KEY=

# Cloudflare Tunnel: get token at https://one.dash.cloudflare.com/
CLOUDFLARE_TUNNEL_TOKEN=

# ── Docker Compose profiles ─────────────────────────────────────
# Uncomment to enable optional services:
# COMPOSE_PROFILES=docs,remote
