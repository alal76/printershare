# printershare — environment variables
# Copy to .env and edit before running `make start`

# ── Host paths ──────────────────────────────────────────────────
# Where scans land on the Linux host (shared via Samba AND NFS)
SCANS_HOST_PATH=/srv/printershare/scans

# rclone config dir (populated by `make setup-rclone`)
RCLONE_CONFIG_PATH=/root/.config/rclone

# ── CUPS ────────────────────────────────────────────────────────
CUPS_ADMIN_USER=admin
CUPS_ADMIN_PASS=changeme

# ── Scanservjs ──────────────────────────────────────────────────
SCANSERVJS_PORT=8080
RCLONE_GDRIVE_REMOTE=gdrive
RCLONE_ONEDRIVE_REMOTE=onedrive

# ── Samba ───────────────────────────────────────────────────────
# Windows: \\<SERVER_IP>\Scans   Mac: smb://<SERVER_IP>/Scans
SAMBA_USER=scanner
SAMBA_PASS=scanner123

# ── Nginx ───────────────────────────────────────────────────────
NGINX_HTTP_PORT=80

# ── NFS ─────────────────────────────────────────────────────────
# Edit nfs/exports to restrict to your LAN subnet e.g. 192.168.1.0/24
NFS_ALLOWED_SUBNET=*
