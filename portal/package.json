{
  "name": "printershare-portal",
  "version": "1.0.0",
  "description": "Unified web portal for printershare — scan, print, docs, settings",
  "private": true,
  "scripts": {
    "dev:client": "vite",
    "dev:server": "node --watch --env-file=.env.local server/index.js",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.4.5",
    "mime-types": "^2.1.35",
    "vue": "^3.4.21",
    "vue-router": "^4.3.2",
    "pinia": "^2.1.7",
    "lucide-vue-next": "^0.372.0",
    "@vueuse/core": "^10.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "vite": "^5.2.10",
    "typescript": "^5.4.5",
    "vue-tsc": "^2.0.14",
    "tailwindcss": "^3.4.3",
    "@tailwindcss/forms": "^0.5.7",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38"
  }
}
